# Auth Service Environment Configuration (template)
# ===================================================
# Copy this file's shape via `./scripts/generate-env-files.sh`, which fills in
# real random secrets and writes `.env.auth-service` (gitignored). Do not fill
# in this .example file with real secrets or commit `.env.auth-service`.
#
# CRITICAL: JWT_SECRET_KEY here MUST exactly match JWT_SECRET_KEY in
# .env.application -- both services validate the same tokens against a single
# shared secret. generate-env-files.sh handles this for you.

ENVIRONMENT=development

# --- Auth database ---
# POSTGRES_PASSWORD for the auth-db container is hardcoded directly in
# docker-compose.separated.yml (not read from this file) -- this value must
# match it exactly or the auth service can't connect to its own database.
AUTH_POSTGRES_USER=auth_user
AUTH_POSTGRES_PASSWORD=auth_secure_password_here
AUTH_POSTGRES_DB=photo_share_auth
AUTH_DB_HOST=auth-db
AUTH_DB_PORT=5432

# --- JWT (shared with the app service) ---
JWT_SECRET_KEY=change-me-must-match-env-application
JWT_ALGORITHM=HS256
JWT_AUDIENCE=photoshare-app
JWT_ISSUER=photoshare-auth
JWT_EXPIRATION_MINUTES=30

# --- 2FA ---
# Fernet key (32 url-safe base64-encoded random bytes). If left unset, the
# service generates one at startup, but it won't survive a restart -- any
# already-encrypted 2FA secrets become unreadable. Set it explicitly for any
# environment that needs to persist across restarts.
TWOFA_ENCRYPTION_KEY=change-me

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- SSO providers (all optional; leave blank to disable a provider) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_DOMAIN=
GENERIC_OIDC_CLIENT_ID=
GENERIC_OIDC_CLIENT_SECRET=
GENERIC_OIDC_DISCOVERY_URL=

# --- SMS 2FA (optional) ---
SMS_PROVIDER_API_KEY=
SMS_FROM_NUMBER=

# --- WebAuthn (optional; defaults are fine for local dev) ---
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=PhotoShare
