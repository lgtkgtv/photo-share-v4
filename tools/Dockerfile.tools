# SBOM Agent Docker Image
# Version: 2.1.0

FROM python:3.11-slim

# Set working directory
WORKDIR /tools

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy minimal requirements first for better caching
COPY requirements_minimal.txt /tools/

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements_minimal.txt

# Copy tools source code
COPY . /tools/

# Make sure the Python path is set
ENV PYTHONPATH=/tools

# Create reports directory
RUN mkdir -p /reports

# Set permissions
RUN chmod +x /tools/sbom-agent/src/cli.py

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python /tools/sbom-agent/src/cli.py --help || exit 1

# Default command
CMD ["python", "/tools/sbom-agent/src/cli.py", "--help"]