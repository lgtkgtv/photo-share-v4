# Environment Configuration Template
# Copy this file to .env and update the values for your environment

# Database Configuration
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_USER=postgres
POSTGRES_DB=photo_share
DB_HOST=platform-db
DB_PORT=5432

# Security Configuration
# IMPORTANT: Generate a secure secret key for production!
# Run: python3 scripts/generate-jwt-secrets.py --update-env .env
SECRET_KEY=your-very-secure-secret-key-here-change-in-production
JWT_SECRET_KEY=generate_with_script_or_use_secure_random_string

# CORS Configuration
# Update with your frontend URLs
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# Platform Configuration
PLATFORM_AUTH_URL=http://platform-auth:8001
PLATFORM_STORAGE_URL=http://platform-storage:8002
SERVICE_REGISTRY_URL=http://consul:8500

# Monitoring Configuration
GRAFANA_PASSWORD=change_this_password

# Redis Configuration
REDIS_URL=redis://redis-cache:6379/0

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Email Configuration (if using real email service)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASSWORD=your_email_password
# SMTP_TLS=true

# File Upload Configuration
# MAX_FILE_SIZE_MB=50
# ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Security Features
# RATE_LIMIT_REQUESTS_PER_MINUTE=60
# SESSION_TIMEOUT_MINUTES=30
# EMAIL_VERIFICATION_EXPIRY_HOURS=24