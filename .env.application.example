# Application Service Environment Configuration (template)
# ===========================================================
# Copy this file's shape via `./scripts/generate-env-files.sh`, which fills in
# real random secrets and writes `.env.application` (gitignored). Do not fill
# in this .example file with real secrets or commit `.env.application`.
#
# CRITICAL: JWT_SECRET_KEY here MUST exactly match JWT_SECRET_KEY in
# .env.auth-service -- both services validate the same tokens against a single
# shared secret. generate-env-files.sh handles this for you.

ENVIRONMENT=development

# --- App database ---
# POSTGRES_PASSWORD for the app-db container is hardcoded directly in
# docker-compose.separated.yml (not read from this file) -- this value must
# match it exactly or the app service can't connect to its own database.
APP_POSTGRES_USER=app_user
APP_POSTGRES_PASSWORD=app_secure_password_here
APP_POSTGRES_DB=photo_share_app
APP_DB_HOST=app-db
APP_DB_PORT=5432

# --- JWT (shared with the auth service) ---
JWT_SECRET_KEY=change-me-must-match-env-auth-service
JWT_ALGORITHM=HS256
JWT_AUDIENCE=photoshare-app
JWT_ISSUER=photoshare-auth

# --- Auth service integration ---
AUTH_SERVICE_URL=http://auth-service:8000
AUTH_SERVICE_API_KEY=

# --- File storage ---
STORAGE_PATH=/app/storage
STORAGE_SECRET_KEY=change-me
MAX_FILE_SIZE_MB=50

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
