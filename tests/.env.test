# Test Environment Configuration
ENVIRONMENT=test
DEBUG=false

# Database Configuration (Test)
DB_HOST=localhost
DB_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=photo_share_test

# JWT Configuration (Test)
JWT_SECRET_KEY=test_jwt_secret_key_for_testing_only_not_for_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# Redis Configuration (Test)
REDIS_HOST=localhost  
REDIS_PORT=16379
REDIS_PASSWORD=

# File Storage (Test)
UPLOAD_DIR=tests/test_data/uploads
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp

# API Configuration (Test)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true

# Email Configuration (Test - Mock)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=test@example.com
SMTP_PASSWORD=test_password
SMTP_TLS=false
FROM_EMAIL=test@photo-share.com

# Performance Configuration (Test)
CACHE_TTL=300
RATE_LIMIT_PER_MINUTE=1000
MAX_CONCURRENT_UPLOADS=50

# Security Configuration (Test)
PASSWORD_MIN_LENGTH=8
BCRYPT_ROUNDS=4
SESSION_TIMEOUT_MINUTES=60

# Monitoring Configuration (Test)
PROMETHEUS_PORT=9090
HEALTH_CHECK_TIMEOUT=10